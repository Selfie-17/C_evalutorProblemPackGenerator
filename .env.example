# ==============================================================================
# C Lab Evaluator & Problem Pack Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local development: leave empty to use SQLite (auto-creates data/c_eval.db)
# Production (Aiven PostgreSQL): postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Cloud AI (Google Gemini)
# ------------------------------------------------------------------------------
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. LLM Provider Settings
# ------------------------------------------------------------------------------
# Provider for AI generation and viva questions: "gemini" (cloud) or "ollama" (local)
LLM_PROVIDER=gemini

# Optional local Ollama settings (used only if LLM_PROVIDER=ollama or as local fallback)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:3b
VIVA_GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Compiler Settings (Linux / Docker / Windows)
# ------------------------------------------------------------------------------
# Compiler executable: "gcc" (Linux/Docker) or path to gcc.exe (Windows MSYS2)
CC=gcc
CFLAGS=-std=c11 -O2 -pipe

# ------------------------------------------------------------------------------
# 5. Evaluation & Execution Sandbox Limits
# ------------------------------------------------------------------------------
# Concurrency worker threads for batch evaluation
MAX_EVALUATION_WORKERS=3

# Program timeouts in seconds
DEFAULT_EXECUTION_TIMEOUT=5
MAX_EXECUTION_TIMEOUT=15

# Payload size limits in bytes
MAX_CODE_SIZE=65536
MAX_STDIN_SIZE=262144
MAX_OUTPUT_SIZE=1048576

# ------------------------------------------------------------------------------
# 6. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated if multiple).
# Production: https://your-c-evaluator.vercel.app
# Local dev automatically allows http://localhost:5173
FRONTEND_URL=
