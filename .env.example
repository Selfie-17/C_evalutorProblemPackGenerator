# ==========================================
# C Compiler & Judge Backend Configuration
# ==========================================

# --- Local LLM / Ollama Configuration ---
# URL for your local Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default model for problem generation (optimized for 6GB VRAM GPUs)
LLM_MODEL=qwen2.5-coder:3b

# Request timeout in seconds for LLM generation
LLM_TIMEOUT_SECONDS=120

# Optional OpenAI-Compatible Local Endpoint (e.g., LM Studio, llama.cpp server)
# LLM_OPENAI_BASE_URL=http://localhost:1234/v1

# --- Personalized Viva Question Generator Settings ---
# Default provider for viva question generation: "ollama" (local offline) or "gemini" (cloud)
VIVA_LLM_PROVIDER=ollama

# Local Ollama model for viva generation
VIVA_OLLAMA_MODEL=qwen2.5-coder:3b

# Google Gemini model for viva generation (e.g., gemini-3.7-flash, gemini-2.5-flash)
VIVA_GEMINI_MODEL=gemini-3.7-flash

# Google Gemini API Key (Required only if VIVA_LLM_PROVIDER=gemini or using Gemini override)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
